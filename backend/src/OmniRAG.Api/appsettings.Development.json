{
  "Azure": {
    "KeyVaultName": "AngularChatbotKV",
    "UseKeyVault": "True",
    "Storage": {
      "ContainerName": "documents"
    },
    "OpenAI": {
      "Endpoint": "https://YOUR-AZURE-OPENAI-NAME.openai.azure.com/",
      "ChatDeploymentName": "YOUR-CHAT-DEPLOYMENT-NAME",
      "EmbeddingDeploymentName": "YOUR-EMBEDDING-DEPLOYMENT-NAME"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}

